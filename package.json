{
  "name": "@podofun/agentd-sdk",
  "version": "0.1.0-alpha.1",
  "description": "Standalone TypeScript WebSocket client for agent.d",
  "keywords": [
    "agentd",
    "agent.d",
    "websocket",
    "sdk"
  ],
  "license": "MIT",
  "author": "podofun",
  "homepage": "https://github.com/podofun/agentd-sdk#readme",
  "repository": "github:podofun/agentd-sdk",
  "bugs": {
    "url": "https://github.com/podofun/agentd-sdk/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run lint && npm run build"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
